{
  "name": "@lego-wargame-terrain-studio/server",
  "version": "1.0.0",
  "description": "Unified backend: domain engine, SQLite WAL persistence, MCP stdio server and WebSocket bridge",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "serve": "node dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test 'test/**/*.test.ts' 'test/**/*.test.js'",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js -p domain"
  },
  "dependencies": {
    "@lego-wargame-terrain-studio/api": "*",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@open-rpc/schema-utils-js": "^2.2.1",
    "@open-rpc/server-js": "^1.10.1",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.8.1",
    "ws": "^8.18.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2"
  }
}
