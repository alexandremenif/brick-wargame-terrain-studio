{
  "name": "@lego-wargame-terrain-studio/ui",
  "version": "1.0.0",
  "description": "Web Studio UI frontend and Canvas editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && esbuild src/webawesome-elements.ts --bundle --outfile=dist/webawesome.elements.iife.js --format=iife --minify --target=es2022",
    "preview": "vite preview",
    "test": "tsc",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js -p ui"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "@lego-wargame-terrain-studio/domain": "*",
    "@open-rpc/client-js": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
