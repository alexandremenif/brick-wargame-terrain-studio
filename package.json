{
  "name": "lego-wargame-terrain-studio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Editor and playmat generator studio for LEGO Wargame Terrain Studio with MCP server and Web Studio",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "codegen:jsonrpc": "node packages/jsonrpc-generator/bin/jsonrpc-generator.js --service-name TerrainEngineService --client-name TerrainApiClient",
    "codegen:dbml": "node packages/dbml-generator/bin/dbml-generator.js",
    "codegen": "npm run codegen:jsonrpc && npm run codegen:dbml",
    "build": "npm run codegen && npm run build --workspaces",
    "dev:server": "npm --workspace=@lego-wargame-terrain-studio/server run dev",
    "dev:ui": "npm --workspace=@lego-wargame-terrain-studio/ui run dev",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js -p domain",
    "test:bdd:domain": "NODE_OPTIONS='--import tsx' cucumber-js -p domain",
    "test:bdd:jsonrpc": "NODE_OPTIONS='--import tsx' cucumber-js -p jsonrpc",
    "test:bdd:mcp": "NODE_OPTIONS='--import tsx' cucumber-js -p mcp",
    "test:bdd:persistence": "NODE_OPTIONS='--import tsx' cucumber-js -p persistence",
    "test:bdd:headless": "npm run test:bdd:domain && npm run test:bdd:jsonrpc && npm run test:bdd:persistence && npm run test:bdd:mcp",
    "test:bdd:ui": "NODE_OPTIONS='--import tsx' cucumber-js -p ui",
    "test:bdd:all": "npm run test:bdd:headless && npm run test:bdd:ui",
    "mockups:render": "node scripts/render_mockups.mjs",
    "test": "npm run --if-present test --workspaces && npm run test:bdd:domain"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/pretty-formatter": "^4.1.0",
    "@dbml/cli": "^3.12.0",
    "@dbml/core": "^3.12.0",
    "@open-rpc/client-js": "^2.1.0",
    "@open-rpc/schema-utils-js": "^2.1.2",
    "@open-rpc/server-js": "^1.10.1",
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@open-rpc/meta-schema": "^1.14.9"
  }
}
