{
  "default": {
    "paths": [
      "specs/domain/features/**/*.feature",
      "specs/server/features/**/*.feature"
    ],
    "import": [
      "packages/server/test/steps/**/*.ts",
      "packages/server/test/support/**/*.ts"
    ],
    "format": ["summary", "progress-bar"],
    "worldParameters": { "driver": "memory" }
  },
  "domain": {
    "paths": [
      "specs/domain/features/**/*.feature",
      "specs/server/features/**/*.feature"
    ],
    "import": [
      "packages/server/test/steps/**/*.ts",
      "packages/server/test/support/**/*.ts"
    ],
    "format": ["summary", "progress-bar"],
    "worldParameters": { "driver": "memory" }
  },
  "jsonrpc": {
    "paths": [
      "specs/domain/features/**/*.feature",
      "specs/server/features/**/*.feature"
    ],
    "import": [
      "packages/server/test/steps/**/*.ts",
      "packages/server/test/support/**/*.ts",
      "packages/server/test/hooks/**/*.ts"
    ],
    "format": ["summary", "progress-bar"],
    "worldParameters": { "driver": "jsonrpc" }
  },
  "persistence": {
    "paths": ["specs/server/features/persistence.feature"],
    "import": [
      "packages/server/test/steps/**/*.ts",
      "packages/server/test/support/**/*.ts"
    ],
    "format": ["summary", "progress-bar"]
  },
  "mcp": {
    "paths": [
      "specs/domain/features/**/*.feature",
      "specs/server/features/**/*.feature"
    ],
    "import": [
      "packages/server/test/steps/**/*.ts",
      "packages/server/test/support/**/*.ts",
      "packages/server/test/hooks/**/*.ts"
    ],
    "format": ["summary", "progress-bar"],
    "worldParameters": { "driver": "mcp" }
  },
  "ui": {
    "paths": ["specs/ui/features/**/*.feature"],
    "import": [
      "packages/ui/test/steps/**/*.ts",
      "packages/ui/test/support/**/*.ts",
      "packages/ui/test/hooks/**/*.ts"
    ],
    "format": ["summary", "progress-bar"],
    "tags": "@ui"
  }
}
