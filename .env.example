# Port configuration for multi-worktree local orchestration
# Copy this file to .env in your worktree to override defaults.

# Backend HTTP & JSON-RPC server port (default: 3000)
SERVER_PORT=3000

# Frontend Web Studio Vite dev server port (default: 5173)
UI_PORT=5173

# Process Compose TUI/API orchestrator port & socket (prevents collision across worktrees)
# Default is 8080
PC_PORT_NUM=8080
PC_SOCKET_PATH=/tmp/process-compose-8080.sock
