// ============================================================================
// LEGO Wargame Terrain Studio - DBML Schema (Database Markup Language)
// Initial Schema Iteration (v1) for Single Asset Studio & Parity MVP
// ============================================================================

Project lego_wargame_terrain_studio {
  database_type: 'SQLite'
  Note: 'First iteration persistence schema for LEGO Wargame Terrain Studio'
}

Table project_metadata {
  key varchar [pk, note: 'Configuration key']
  value text [not null]
  Note: 'Global project metadata'
}

Table lego_colors {
  id integer [pk, note: 'Official LEGO / BrickLink code']
  name varchar [not null, note: 'Standard color name (e.g., Bright Green, Dark Tan)']
  hex varchar(7) [not null, note: 'Hexadecimal format #RRGGBB']
  Note: 'Official LEGO color palette'
}

Table assets {
  id varchar(36) [pk, note: 'Unique asset identifier']
  name varchar(100) [not null, note: 'Asset name']
  width integer [not null, note: 'Width in stud count (>= 1)']
  height integer [not null, note: 'Height in stud count (>= 1)']
  bbox_x integer [null, note: 'Active bounding box X']
  bbox_y integer [null, note: 'Active bounding box Y']
  bbox_width integer [null, note: 'Active bounding box width']
  bbox_height integer [null, note: 'Active bounding box height']
  created_at timestamp [default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [default: `CURRENT_TIMESTAMP`]
  Note: 'Single editable asset'
}

Table cells {
  asset_id varchar(36) [not null]
  x integer [not null, note: 'X coordinate in studs (0 <= x < width)']
  y integer [not null, note: 'Y coordinate in studs (0 <= y < height)']
  color_id integer [not null, note: 'Applied LEGO color code']
  Note: 'Customized studs matrix'

  indexes {
    (asset_id, x, y) [pk]
    (asset_id, x, y) [name: 'idx_cells_spatial']
  }
}

// Relationships & Foreign Keys
Ref: cells.asset_id > assets.id [delete: cascade]
Ref: cells.color_id > lego_colors.id [delete: restrict]
