// ============================================================================
// Brick Wargame Terrain Studio - DBML Schema (Database Markup Language)
// Initial Schema Iteration (v1) for Single Asset Studio & Parity MVP
// ============================================================================

Project brick_wargame_terrain_studio {
  database_type: 'SQLite'
  Note: 'First iteration persistence schema for Brick Wargame Terrain Studio'
}

Table schema_migrations {
  version integer [pk, note: 'Monotonic migration version (e.g., 1)']
  name varchar(100) [not null, note: 'Migration name (e.g., 0001_initial_schema)']
  applied_at timestamp [default: `CURRENT_TIMESTAMP`, note: 'Execution timestamp']
  Note: 'Explicit record of applied database schema migrations'
}

Table assets {
  id varchar(36) [pk, not null, note: "check: id = (data ->> '$.id')"]
  name varchar(100) [not null, note: "generated: (data ->> '$.name')"]
  width integer [not null, note: "generated: (data ->> '$.width')"]
  height integer [not null, note: "generated: (data ->> '$.height')"]
  painted_cells_count integer [not null, note: "generated: (data ->> '$.paintedCellsCount')"]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  data blob [not null, note: "check: json_valid(data, 4)"]
  Note: 'Single-table JSONB aggregate root with stored derived summary columns'

  indexes {
    (created_at) [name: 'idx_assets_created_at']
  }
}
